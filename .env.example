# ==========================================================
# CEN WORK — Biến môi trường cho bản deploy độc lập (Mắt Bão)
# Sao chép thành .env.runtime rồi điền giá trị thật.
# KHÔNG commit tệp chứa giá trị thật lên kho mã.
# ==========================================================

# --- Chế độ dữ liệu -------------------------------------------------------
# postgres = dùng PostgreSQL do bạn sở hữu (bắt buộc khi deploy Mắt Bão).
VITE_CEN_DB=postgres

# --- Kết nối PostgreSQL (chỉ đọc phía máy chủ) ----------------------------
DATABASE_URL=postgresql://cen_owner:MAT_KHAU@127.0.0.1:5432/cen_work
# disable | no-verify | (bỏ trống = xác thực chứng chỉ đầy đủ)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Bí mật máy chủ -------------------------------------------------------
# Token một lần dùng cho trang /setup tạo tài khoản Admin đầu tiên.
# Sinh bằng: openssl rand -hex 32
CEN_BOOTSTRAP_TOKEN=
# Bí mật để hệ thống cron của máy chủ gọi /api/public/hooks/cron.
# Sinh bằng: openssl rand -hex 32
CEN_CRON_SECRET=

# CEN-AI — API cho n8n/GPT (chỉ cấu hình trên máy chủ).
# Key dùng chung cho endpoint đọc /api/ai/read và ghi /api/ai/act.
CEN_AI_READ_KEY=
# UUID user CEN mà hệ thống tự động hóa đại diện; quyền vẫn theo RLS/trigger.
CEN_AI_VIEWER_USER_ID=

# --- Telegram (tùy chọn) --------------------------------------------------
# Có thể cấu hình trong ứng dụng; biến này chỉ là phương án dự phòng.
TELEGRAM_BOT_TOKEN=

# --- Web Push (tùy chọn, CEN-PUSH-P01) -----------------------------------
# Sinh bằng: npm run push:vapid — private key chỉ để trên máy chủ.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cenwork.tudogroup.vn

# --- Máy chủ --------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# --- Email SMTP (TASK-DAILY-01B, báo cáo công việc hằng ngày) -------------
# Bắt buộc nếu muốn gửi báo cáo qua email. Chỉ đặt ở máy chủ.
SMTP_HOST=
SMTP_PORT=587
# true nếu dùng cổng 465 (SSL). Bỏ trống = tự suy ra theo cổng.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CEN WORK <no-reply@cenwork.tudogroup.vn>
