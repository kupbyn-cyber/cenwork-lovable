# ==========================================================
# CEN WORK — Biến môi trường cho bản deploy độc lập (Mắt Bão)
# Sao chép thành .env.runtime rồi điền giá trị thật.
# KHÔNG commit tệp chứa giá trị thật lên kho mã.
# ==========================================================

# --- Chế độ dữ liệu -------------------------------------------------------
# postgres = dùng PostgreSQL do bạn sở hữu (bắt buộc khi deploy Mắt Bão).
VITE_CEN_DB=postgres

# --- Kết nối PostgreSQL (chỉ đọc phía máy chủ) ----------------------------
DATABASE_URL=postgresql://cen_owner:MAT_KHAU@127.0.0.1:5432/cen_work
# disable | no-verify | (bỏ trống = xác thực chứng chỉ đầy đủ)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Bí mật máy chủ -------------------------------------------------------
# Token một lần dùng cho trang /setup tạo tài khoản Admin đầu tiên.
# Sinh bằng: openssl rand -hex 32
CEN_BOOTSTRAP_TOKEN=
# Bí mật để hệ thống cron của máy chủ gọi /api/public/hooks/cron.
# Sinh bằng: openssl rand -hex 32
CEN_CRON_SECRET=

# --- Telegram (tùy chọn) --------------------------------------------------
# Có thể cấu hình trong ứng dụng; biến này chỉ là phương án dự phòng.
TELEGRAM_BOT_TOKEN=

# --- Máy chủ --------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
